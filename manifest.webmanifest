{
  "id": "/",
  "name": "MCP Reading Order",
  "short_name": "MCP Order",
  "description": "Builds the Marvel Chronology master reading order from files kept in GitHub.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "lang": "en",
  "categories": [
    "books",
    "productivity",
    "utilities"
  ],
  "background_color": "#16233a",
  "theme_color": "#16233a",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screenshot-wide.png",
      "sizes": "2560x1600",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Run the pipeline and download the CSV results"
    },
    {
      "src": "icons/screenshot-phone.png",
      "sizes": "1080x2340",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Build the reading order on your phone"
    }
  ],
  "shortcuts": [
    {
      "name": "Run pipeline",
      "short_name": "Run",
      "url": "./?tab=run",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Files",
      "url": "./?tab=files",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
